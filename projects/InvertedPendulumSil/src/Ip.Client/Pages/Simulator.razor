@page "/"
@implements IAsyncDisposable
@inject PlantRunner Runner
@inject NavigationManager Navigation
@inject IJSRuntime Js

<div class="app">
    <h1>台車型倒立振子 SIL シミュレータ</h1>
    <p class="sub">
        プラント(台車・振子・モータ)は Blazor WebAssembly 上で 1ms 固定ステップ、
        コントローラ(ASP.NET Core)は別プロセスで動き、両者は遅延を注入した SignalR 通信路だけでつながっています。
        全制御をバック側で行う純 SIL 構成で、通信遅延が倒立維持に与える影響を観察できます。
    </p>

    <div class="views">
        <div class="view">
            <div class="vhead">
                <span>側面図 — タップした側から振子を押す</span>
                <span class="legend">
                    <span><i></i>プラント実状態</span>
                    <span><i class="ghost"></i>バックが見ている状態</span>
                </span>
            </div>
            <canvas id="c2d" aria-label="台車型倒立振子の側面図"></canvas>
        </div>
        <div class="view">
            <div class="vhead"><span>3D ビュー</span><span>ドラッグで回転 / タップで外乱</span></div>
            <canvas id="c3d" aria-label="3Dビュー"></canvas>
            <div id="fallback3d">3Dビューを読み込めませんでした。側面図は引き続き使えます。</div>
        </div>
    </div>

    <div class="panel">
        <div class="statusbar">
            <span class="mode" data-m="@ModeKey" data-testid="mode" role="status" aria-live="polite">@ModeLabel</span>
            <span class="reason" data-testid="reason">@StatusReason</span>
            <span class="badges">
                <span class="badge @(Runner.Link == LinkState.Connected ? "" : "warn")" data-testid="link">通信: @Runner.LinkDetail</span>
                <span class="badge">時計同期: RTT @Fmt(Runner.ClockRoundTripMs, 1, " ms") / 補正 @Fmt(Runner.ClockOffsetMs, 0, " ms")</span>
            </span>
        </div>

        <div class="row">
            <button data-testid="btn-swingup" disabled="@(!CanStart)" @onclick="@(() => Runner.OperateAsync(OperatorAction.SwingUp))">スイングアップ開始</button>
            <button data-testid="btn-balance" class="ghost" disabled="@(!CanStart)"
                    title="プラントを倒立姿勢に初期化してから開始します (ドライブ無効状態もここで解除されます)"
                    @onclick="Runner.StartFromUprightAsync">倒立から開始</button>
            <button data-testid="btn-stop" class="ghost" disabled="@(!IsRunning)" @onclick="@(() => Runner.OperateAsync(OperatorAction.Stop))">停止</button>
            <button data-testid="btn-clear" class="ghost @(IsFaulted ? "attn" : "")" disabled="@(!IsFaulted)" @onclick="@(() => Runner.OperateAsync(OperatorAction.ClearFault))">異常リセット</button>
            <button data-testid="btn-init" class="ghost @(Runner.Telemetry.DriveEnabled ? "" : "attn")" @onclick="Runner.InitializePlantAsync">プラント初期化</button>
            <span class="sep"></span>
            <button data-testid="btn-push-left" class="ghost" aria-label="振子を左へ押す" @onclick="@(() => PushAsync(-1))">◀ 外乱</button>
            <button data-testid="btn-push-right" class="ghost" aria-label="振子を右へ押す" @onclick="@(() => PushAsync(1))">外乱 ▶</button>
            <button data-testid="btn-estop" class="estop" @onclick="Runner.EmergencyStop">非常停止</button>
        </div>

        <div class="split">
            <div>
                <p class="group-title">通信と制御の条件</p>
                <div class="presets" role="group" aria-label="プリセット">
                    @foreach (var (key, preset) in Presets)
                    {
                        <button class="ghost" data-testid="@($"preset-{preset.Key}")" @onclick="@(() => ApplyPresetAsync(preset))">@key</button>
                    }
                </div>

                <div class="sliders">
                    <label class="sl">
                        帰還周期 <output data-testid="value-period">@Periods[_periodIndex] ms</output>
                        <input type="range" data-testid="slider-period" min="0" max="@(Periods.Length - 1)" step="1"
                               value="@_periodIndex" aria-valuetext="@($"{Periods[_periodIndex]} ミリ秒")"
                               @oninput="OnPeriodChangedAsync" />
                        <small>変更するとバック側で離散LQRを再設計</small>
                    </label>
                    <label class="sl">
                        通信遅延(片道) <output>@_latency.ToString("F0") ms (往復 @((_latency * 2).ToString("F0")) ms)</output>
                        <input type="range" data-testid="slider-latency" min="0" max="150" step="1" value="@_latency"
                               @oninput="@(e => OnNetworkSliderAsync(e, v => _latency = v))" />
                    </label>
                    <label class="sl">
                        ジッタ <output>0〜@_jitter.ToString("F0") ms</output>
                        <input type="range" data-testid="slider-jitter" min="0" max="50" step="1" value="@_jitter"
                               @oninput="@(e => OnNetworkSliderAsync(e, v => _jitter = v))" />
                    </label>
                    <label class="sl">
                        遅延スパイク率 <output>@_spike.ToString("F1") %</output>
                        <input type="range" data-testid="slider-spike" min="0" max="10" step="0.5" value="@_spike"
                               @oninput="@(e => OnNetworkSliderAsync(e, v => _spike = v))" />
                        <small>TCP再送相当の +150ms。欠落はしない</small>
                    </label>
                    <label class="sl">
                        エンコーダノイズ <output>σ @_noise.ToString("F1") count</output>
                        <input type="range" data-testid="slider-noise" min="0" max="3" step="0.1" value="@_noise"
                               @oninput="@(e => OnNetworkSliderAsync(e, v => _noise = v))" />
                    </label>
                    <label class="sl">
                        振子長 <output>@_length.ToString("F2") m</output>
                        <input type="range" data-testid="slider-length" min="0.3" max="0.8" step="0.05" value="@_length"
                               @oninput="OnLengthChangedAsync" />
                    </label>
                    <label class="sl">
                        台車の目標位置 <output>@(_targetX >= 0 ? "+" : "")@_targetX.ToString("F2") m</output>
                        <input type="range" data-testid="slider-target" min="-0.3" max="0.3" step="0.05" value="@_targetX"
                               @oninput="OnTargetChangedAsync" />
                    </label>
                </div>

                <label class="toggle">
                    <input type="checkbox" data-testid="toggle-predictor" checked="@_predict" @onchange="OnPredictChangedAsync" />
                    遅延補償(予測器)を使う — 計測済みの E2E 遅延ぶん先の状態を予測して制御
                </label>
            </div>

            <div>
                <div class="budget">
                    <div class="budget-head">
                        <span>遅延予算 (計測→指令適用)</span>
                        <span class="num"><b data-testid="budget-e2e">@Fmt(E2eMs, 0, " ms")</b> / 余裕 <b data-testid="budget-margin">@(MarginMs > 0 ? $"{MarginMs} ms" : "—")</b></span>
                    </div>
                    <div class="track">
                        <div class="fill" data-testid="budget-fill" data-lv="@FillLevel" style="width:@FillPercent.ToString("F1")%"></div>
                        <div class="marker" title="理論遅延余裕"></div>
                    </div>
                    <div class="budget-foot">
                        <span>0</span>
                        <span data-testid="budget-note">@BudgetNote</span>
                        <span>@(BudgetFull > 0 ? $"{BudgetFull:F0} ms" : "—")</span>
                    </div>
                </div>

                <div class="metrics">
                    <div class="metric"><span>実測帰還周期</span><b data-testid="metric-feedback-interval">@Fmt(Controller?.FeedbackIntervalMs ?? double.NaN, 1, " ms")</b></div>
                    <div class="metric"><span>上り遅延(計測→バック受信)</span><b data-testid="metric-uplink-delay">@Fmt(Controller?.UplinkDelayMs ?? double.NaN, 1, " ms")</b></div>
                    <div class="metric"><span>不安定極 / 時定数</span><b data-testid="metric-pole">@PoleText</b></div>
                    <div class="metric"><span>LQR ゲイン K</span><b data-testid="metric-gain" style="font-size:11.5px">@GainText</b></div>
                    <div class="metric"><span>指令電圧</span><b data-testid="metric-volts">@Fmt(Runner.Telemetry.Volts, 2, " V")</b></div>
                    <div class="metric"><span>CommandId / 破棄した指令</span><b data-testid="metric-command">@(Controller is null ? "—" : $"#{Controller.CommandId} / {Runner.Telemetry.RejectedCommands}")</b></div>
                    <div class="metric"><span>送信待ち(上り/下り)</span><b data-testid="metric-queue">@(Controller is null ? "—" : $"{Runner.Telemetry.UplinkQueueLength} / {Controller.DownlinkQueueLength}")</b></div>
                    <div class="metric"><span>時間スリップ</span><b>@Runner.Telemetry.TimeSlips 回</b></div>
                </div>
            </div>
        </div>
    </div>

    <div class="panel">
        <p class="group-title">時系列 (直近10秒) — 破線はバック側の推定値・目標値・理論遅延余裕</p>
        <canvas id="scope" aria-label="時系列チャート"></canvas>
    </div>

    <div class="panel">
        <p class="group-title">イベントログ</p>
        <ul class="log" data-testid="log" role="log" aria-live="polite">
            @if (Runner.Logs.Count == 0)
            {
                <li class="empty">まだイベントはありません。「スイングアップ開始」か「倒立から開始」を押してください。</li>
            }
            else
            {
                @foreach (var entry in Runner.Logs)
                {
                    <li class="@entry.CssClass">
                        <span class="t">@entry.ElapsedSeconds.ToString("F2")s</span>
                        <span class="src">@entry.Source</span>
                        <span class="m">@entry.Message</span>
                    </li>
                }
            }
        </ul>
    </div>

    <DesignNote />
</div>

@code {
    /// <summary>帰還周期の選択肢 [ms]。1ms は実機のドライブ内制御に近く、100ms は前回設計の値。</summary>
    private static readonly int[] Periods = [1, 2, 5, 10, 20, 50, 100];

    private static readonly (string Label, PresetValue Value)[] Presets =
    [
        ("理想 1ms・遅延なし", new PresetValue("ideal", 0, 0, 0, 0)),
        ("LAN 5ms・片道5ms", new PresetValue("lan", 2, 5, 2, 0)),
        ("前回設計 100ms・片道20ms", new PresetValue("legacy", 6, 20, 5, 0)),
        ("WAN 10ms・片道40ms", new PresetValue("wan", 3, 40, 15, 1)),
    ];

    /// <summary>描画へ状態を渡す間隔 [ms]</summary>
    private const int ViewIntervalMs = 20;
    /// <summary>指標表示を更新する間隔。描画の 5 回に 1 回。</summary>
    private const int MetricsEveryNthFrame = 5;

    private int _periodIndex = 2;
    private double _latency;
    private double _jitter;
    private double _spike;
    private double _noise;
    private double _length = 0.6;
    private double _targetX;
    private bool _predict;

    /// <summary>再設計を伴う設定変更のデバウンス時間 [ms]。スライダのドラッグ 1 回で何度も再設計させない。</summary>
    private const int RedesignDebounceMs = 150;

    private IJSObjectReference? _module;
    private DotNetObjectReference<Simulator>? _selfReference;
    private CancellationTokenSource? _uiCts;
    private CancellationTokenSource? _debounceCts;
    private bool _disposed;

    private ControllerStatus? Controller => Runner.Controller;
    private bool IsConnected => Runner.Link == LinkState.Connected;
    private bool IsRunning => Controller is { Mode: ControlMode.SwingUp or ControlMode.Balance };
    private bool IsFaulted => Controller is { Mode: ControlMode.Fault };
    private bool CanStart => IsConnected && Controller is null or { Mode: ControlMode.Idle };

    private string ModeKey => !IsConnected ? "IDLE" : Controller?.Mode switch
    {
        ControlMode.SwingUp => "SWINGUP",
        ControlMode.Balance => "BALANCE",
        ControlMode.Fault => "FAULT",
        ControlMode.Idle => "IDLE",
        _ => "IDLE",
    };

    /// <summary>
    /// 通信が切れている間は制御状態を表示しない。
    /// 最後に受け取った状態を出し続けると、制御が死んでいても「倒立制御中」と表示され続ける。
    /// </summary>
    private string ModeLabel => Runner.Link switch
    {
        LinkState.Connecting => "起動中",
        LinkState.Reconnecting => "UNKNOWN 通信断 (再接続中)",
        LinkState.Disconnected => "UNKNOWN 通信断",
        _ => Controller?.Mode switch
        {
            ControlMode.SwingUp => "SWINGUP 振り上げ中",
            ControlMode.Balance => "BALANCE 倒立制御中",
            ControlMode.Fault => "FAULT 異常停止",
            ControlMode.Idle => "IDLE 待機",
            _ => "起動中",
        },
    };

    private string StatusReason => Runner.PlantStopped
        ? "プラントの積分ループが停止しました。再読み込みしてください。"
        : !IsConnected ? Runner.LinkDetail
        : Controller?.Reason is { Length: > 0 } reason ? reason
        : "準備完了";

    private int MarginMs => Runner.Design?.DelayMarginMs ?? 0;
    private double BudgetFull => MarginMs * 1.5;

    private double E2eMs => IsRunning && Controller!.E2EDelayMs > 0 ? Controller.E2EDelayMs : double.NaN;

    private double FillPercent => double.IsFinite(E2eMs) && BudgetFull > 0
        ? Math.Min(100.0, E2eMs / BudgetFull * 100.0)
        : 0.0;

    private double MarginRatio => double.IsFinite(E2eMs) && MarginMs > 0 ? E2eMs / MarginMs : 0.0;

    private string FillLevel => MarginRatio >= 1.0 ? "danger" : MarginRatio >= 0.7 ? "warn" : "ok";

    private string BudgetNote => _predict ? "予測補償中 — 縦線は補償なしの理論値"
        : !IsRunning ? "制御中のみ計測"
        : MarginRatio >= 1.0 ? "理論余裕を超過 — 外乱で転倒しやすい"
        : "縦線が理論遅延余裕";

    private string PoleText => Runner.Design is { } design
        ? $"{design.UnstablePole:F2} rad/s / {1000.0 / design.UnstablePole:F0} ms"
        : "—";

    private string GainText => Runner.Design is { } design
        ? string.Join(", ", design.Gains.Select(g => g.ToString("F1")))
        : "—";

    private static string Fmt(double value, int digits, string unit)
        => double.IsFinite(value) ? value.ToString($"F{digits}") + unit : "—";

    protected override void OnInitialized() => Runner.Changed += OnRunnerChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // import やハブ接続の await 中に離脱されると、DisposeAsync は「まだ何も無い」状態で帰る。
        // その後ここが再開すると、破棄済みコンポーネントの上で描画ループが永久に回り始めるため、
        // 各 await の後で破棄済みかどうかを必ず確認する。
        var module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/sim-view.js");
        if (_disposed)
        {
            await module.DisposeAsync();
            return;
        }
        _module = module;

        _selfReference = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("init", _selfReference);
        if (_disposed) return;

        await Runner.StartAsync(new Uri(Navigation.ToAbsoluteUri("/hub/sil").ToString()));
        if (_disposed) return;

        await ApplyNetworkAsync();
        if (_disposed) return;

        _uiCts = new CancellationTokenSource();
        _ = RunViewLoopAsync(_uiCts.Token);
    }

    /// <summary>キャンバスのタップから呼ばれる外乱。</summary>
    [JSInvokable]
    public void OnPush(int direction) => Runner.Push(direction);

    /// <summary>
    /// 描画と指標表示の更新ループ。制御ループとは独立しているので、
    /// ここが重くなってもプラントの積分周期には影響しない。
    /// </summary>
    private async Task RunViewLoopAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(ViewIntervalMs));
        int frame = 0;
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                if (_module is not null) await _module.InvokeVoidAsync("update", token, BuildViewState());
                if (++frame % MetricsEveryNthFrame == 0) await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private ViewState BuildViewState()
    {
        var telemetry = Runner.Telemetry;
        var controller = Controller;
        bool hasEstimate = controller is { FeedbackCount: > 0 };

        return new ViewState(
            telemetry.SimSeconds, telemetry.X, telemetry.Theta, telemetry.Volts, telemetry.DriveEnabled,
            telemetry.E2EMs, hasEstimate,
            controller?.EstimatedX ?? 0.0, controller?.EstimatedTheta ?? 0.0, controller?.TargetX ?? 0.0,
            IsRunning, _length, MarginMs);
    }

    private void OnRunnerChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task PushAsync(int direction)
    {
        Runner.Push(direction);
        if (_module is not null) await _module.InvokeVoidAsync("pushEffect", direction);
    }

    private Task OnPeriodChangedAsync(ChangeEventArgs e)
    {
        _periodIndex = int.TryParse(e.Value?.ToString(), out int index)
            ? Math.Clamp(index, 0, Periods.Length - 1)
            : _periodIndex;
        return DebounceRedesignAsync(ApplyNetworkAsync);
    }

    /// <summary>
    /// 帰還周期と振子長の変更はバック側で離散 LQR と遅延余裕の再設計を起こす。
    /// スライダをドラッグすると 1 目盛りごとに走って制御ループを止めるので、止まったところで 1 回だけ送る。
    /// </summary>
    private async Task DebounceRedesignAsync(Func<Task> send)
    {
        var previous = _debounceCts;
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;
        if (previous is not null)
        {
            await previous.CancelAsync();
            previous.Dispose();
        }

        try
        {
            await Task.Delay(RedesignDebounceMs, token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (!_disposed) await send();
    }

    private Task OnNetworkSliderAsync(ChangeEventArgs e, Action<double> assign)
    {
        if (double.TryParse(e.Value?.ToString(), out double value)) assign(value);
        return ApplyNetworkAsync();
    }

    private Task OnLengthChangedAsync(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out double value)) _length = value;
        return DebounceRedesignAsync(() => Runner.SetPlantAsync(new PlantConfig(_length)));
    }

    private Task OnTargetChangedAsync(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out double value)) _targetX = value;
        return ApplyOptionsAsync();
    }

    private Task OnPredictChangedAsync(ChangeEventArgs e)
    {
        _predict = e.Value is bool flag && flag;
        return ApplyOptionsAsync();
    }

    private Task ApplyPresetAsync(PresetValue preset)
    {
        _periodIndex = preset.PeriodIndex;
        _latency = preset.Latency;
        _jitter = preset.Jitter;
        _spike = preset.Spike;
        Runner.NoteOperation(
            $"プリセット「{Presets.First(p => p.Value.Key == preset.Key).Label}」を適用: 周期 {Periods[_periodIndex]} ms, 片道 {_latency:0} ms, ジッタ {_jitter:0} ms, スパイク {_spike:0.0} %");
        return ApplyNetworkAsync();
    }

    private Task ApplyNetworkAsync()
        => Runner.SetNetworkAsync(new NetworkConfig(Periods[_periodIndex], _latency, _jitter, _spike, _noise));

    private Task ApplyOptionsAsync()
        => Runner.SetOptionsAsync(Runner.Options with { UsePredictor = _predict, CartTargetMeters = _targetX });

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Runner.Changed -= OnRunnerChanged;
        if (_debounceCts is not null)
        {
            await _debounceCts.CancelAsync();
            _debounceCts.Dispose();
            _debounceCts = null;
        }
        if (_uiCts is not null)
        {
            await _uiCts.CancelAsync();
            _uiCts.Dispose();
        }
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
        _selfReference?.Dispose();
    }

    /// <summary>プリセット 1 件ぶんの通信条件。<paramref name="Key"/> は E2E から参照する識別子。</summary>
    private readonly record struct PresetValue(string Key, int PeriodIndex, double Latency, double Jitter, double Spike);
}
