{
  "name": "wasmemusil",
  "private": true,
  "type": "module",
  "description": "WasmEmuSil の TypeScript 側 (pnpm workspace): ui-kit / sim-ui / shell。Rust 側は Cargo ワークスペース",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './apps/**' run build",
    "typecheck": "pnpm -r --filter './apps/**' run typecheck",
    "lint": "eslint . && pnpm run typecheck",
    "test": "pnpm -r --filter './apps/**' run test",
    "dev:ui": "pnpm --filter @ipemu/sim-ui run dev",
    "shell": "pnpm --filter @ipemu/shell run start"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "globals": "^16.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
