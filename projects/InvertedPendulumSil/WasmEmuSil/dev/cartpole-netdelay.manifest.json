{
  "manifestVersion": 1,
  "id": "dev-cartpole-netdelay",
  "revision": 1,
  "name": "開発用: 通信路を制御ループに入れた台車型倒立振子 (NetworkedSil の遅延実験の再現, 往復 80 ms)",
  "description": "MCU (制御側) と駆動系 (プラント側) の間の信号をすべて comm-link に通す。上り: エンコーダ計数・ドライブ FAULT / 有効、下り: PWM・ドライブ有効・ハートビート。片道 40 ms (往復 80 ms)。倒立付近 (θ=0.02 rad) から balance で開始し、2.03 s から 2 s ごとに 0.3 Nm × 50 ms の外乱を交互の向きに加える。Docs/10-delay-comparison.md を参照。署名・sha256 なし (--no-signature-check が必要)。",
  "scheduler": {
    "baseStepNs": 1000000,
    "pacing": "fast",
    "snapshotDivider": 10
  },
  "artifacts": {
    "plant-cartpole@0.1.0": {
      "kind": "part",
      "path": "../build/components/plant-cartpole.wasm"
    },
    "motor-driver@0.1.0": {
      "kind": "part",
      "path": "../build/components/motor-driver.wasm"
    },
    "encoder@0.1.0": {
      "kind": "part",
      "path": "../build/components/encoder.wasm"
    },
    "comm-link@0.1.0": {
      "kind": "part",
      "path": "../build/components/comm-link.wasm"
    },
    "fw-balance-c@0.1.0": {
      "kind": "firmware",
      "path": "../build/firmware/fw-balance-c.wasm"
    },
    "fw-balance-rs@0.1.0": {
      "kind": "firmware",
      "path": "../build/firmware/fw-balance-rs.wasm"
    },
    "ui-cartpole@0.1.0": {
      "kind": "ui",
      "path": "../build/ui/ui-cartpole.tar.gz"
    }
  },
  "components": [
    {
      "instance": "plant",
      "artifact": "plant-cartpole@0.1.0",
      "params": {
        "cartMass": 0.6,
        "poleMass": 0.15,
        "pendulumLength": 0.6,
        "cartViscousFriction": 1.0,
        "cartCoulombFriction": 0.4,
        "pivotFriction": 0.0008,
        "rotorInertia": 2e-05,
        "railStroke": 0.5,
        "stopperStiffness": 20000.0,
        "stopperDamping": 150.0,
        "motor": {
          "kt": 0.05,
          "ke": 0.05,
          "resistance": 2.0,
          "pulleyRadius": 0.015
        },
        "initial": {
          "theta": 0.02
        },
        "pushes": {
          "torqueNm": 0.3,
          "durationMs": 50,
          "firstAtMs": 2030,
          "everyMs": 2000,
          "alternate": true
        }
      }
    },
    {
      "instance": "driver",
      "artifact": "motor-driver@0.1.0",
      "params": {
        "busVoltage": 24.0,
        "commandTimeoutMs": 500,
        "limitM": 0.501
      }
    },
    {
      "instance": "enc-cart",
      "artifact": "encoder@0.1.0",
      "params": {
        "ppr": 2000,
        "mode": "linear",
        "metersPerRev": 0.09424777960769379
      }
    },
    {
      "instance": "enc-pend",
      "artifact": "encoder@0.1.0",
      "params": {
        "ppr": 4096,
        "mode": "angular"
      }
    },
    {
      "instance": "up-enc-cart",
      "artifact": "comm-link@0.1.0",
      "params": {
        "delayMs": 40,
        "jitterMs": 0,
        "spikePercent": 0,
        "spikeMs": 150,
        "sampleEveryMs": 1,
        "seed": 11
      }
    },
    {
      "instance": "up-enc-pend",
      "artifact": "comm-link@0.1.0",
      "params": {
        "delayMs": 40,
        "jitterMs": 0,
        "spikePercent": 0,
        "spikeMs": 150,
        "sampleEveryMs": 1,
        "seed": 11
      }
    },
    {
      "instance": "up-drv-fault",
      "artifact": "comm-link@0.1.0",
      "params": {
        "delayMs": 40,
        "jitterMs": 0,
        "spikePercent": 0,
        "spikeMs": 150,
        "sampleEveryMs": 1,
        "seed": 11
      }
    },
    {
      "instance": "up-drv-enabled",
      "artifact": "comm-link@0.1.0",
      "params": {
        "delayMs": 40,
        "jitterMs": 0,
        "spikePercent": 0,
        "spikeMs": 150,
        "sampleEveryMs": 1,
        "seed": 11
      }
    },
    {
      "instance": "mcu",
      "kind": "builtin:cpu-virtual",
      "params": {
        "tickHz": 1000,
        "timingModel": {
          "kind": "fuel",
          "nsPerFuel": 2.0
        },
        "peripherals": {
          "enc": 2,
          "pwm": 1,
          "gpioIn": 2,
          "gpioOut": 2,
          "uart": 1
        }
      },
      "firmware": {
        "slot": "balance",
        "world": "ip:emu/firmware@0.1.0",
        "default": "fw-balance-c@0.1.0",
        "allowOverride": [
          "wasm",
          "native"
        ],
        "params": {
          "controlHz": 200.0,
          "k0": -7.889597821567535,
          "k1": -37.63375843811985,
          "k2": -12.20611182672061,
          "k3": -7.22676247663797,
          "cartMass": 0.6,
          "poleMass": 0.15,
          "pendulumLength": 0.6,
          "cartViscousFriction": 1.0,
          "cartCoulombFriction": 0.4,
          "pivotFriction": 0.0008,
          "rotorInertia": 2e-05,
          "pulleyRadius": 0.015,
          "kt": 0.05,
          "ke": 0.05,
          "resistance": 2.0,
          "maxVoltage": 24.0,
          "railStroke": 0.5,
          "busVoltage": 24.0,
          "cartMetersPerCount": 4.712388980384689e-05,
          "pendCountsPerRev": 4096,
          "velocityCutoffHz": 25.0,
          "autoStart": "balance",
          "autoStartDelayMs": 60
        }
      }
    },
    {
      "instance": "dn-pwm",
      "artifact": "comm-link@0.1.0",
      "params": {
        "delayMs": 40,
        "jitterMs": 0,
        "spikePercent": 0,
        "spikeMs": 150,
        "sampleEveryMs": 1,
        "seed": 23
      }
    },
    {
      "instance": "dn-enable",
      "artifact": "comm-link@0.1.0",
      "params": {
        "delayMs": 40,
        "jitterMs": 0,
        "spikePercent": 0,
        "spikeMs": 150,
        "sampleEveryMs": 1,
        "seed": 23
      }
    },
    {
      "instance": "dn-heartbeat",
      "artifact": "comm-link@0.1.0",
      "params": {
        "delayMs": 40,
        "jitterMs": 0,
        "spikePercent": 0,
        "spikeMs": 150,
        "sampleEveryMs": 1,
        "seed": 23
      }
    },
    {
      "instance": "snap",
      "kind": "builtin:snapshot",
      "params": {
        "ports": [
          "plant.x",
          "plant.theta",
          "plant.x-dot",
          "plant.theta-dot",
          "plant.hit-stopper",
          "driver.voltage",
          "driver.drive-enabled",
          "driver.fault",
          "mcu.pwm0",
          "mcu.gpio-out0",
          "mcu.exec-ns",
          "mcu.overruns",
          "up-enc-pend.out",
          "up-enc-pend.in-flight",
          "dn-pwm.out",
          "dn-pwm.in-flight",
          "dn-pwm.hol-blocked"
        ]
      }
    }
  ],
  "wires": [
    {
      "from": "plant.x",
      "to": "enc-cart.input"
    },
    {
      "from": "plant.theta",
      "to": "enc-pend.input"
    },
    {
      "from": "plant.x",
      "to": "driver.position"
    },
    {
      "from": "enc-cart.count",
      "to": "up-enc-cart.in",
      "latency": 0
    },
    {
      "from": "enc-pend.count",
      "to": "up-enc-pend.in",
      "latency": 0
    },
    {
      "from": "driver.fault",
      "to": "up-drv-fault.in"
    },
    {
      "from": "driver.drive-enabled",
      "to": "up-drv-enabled.in"
    },
    {
      "from": "up-enc-cart.out",
      "to": "mcu.enc0"
    },
    {
      "from": "up-enc-pend.out",
      "to": "mcu.enc1"
    },
    {
      "from": "up-drv-fault.out",
      "to": "mcu.gpio-in0"
    },
    {
      "from": "up-drv-enabled.out",
      "to": "mcu.gpio-in1"
    },
    {
      "from": "mcu.pwm0",
      "to": "dn-pwm.in",
      "latency": 0
    },
    {
      "from": "mcu.gpio-out0",
      "to": "dn-enable.in",
      "latency": 0
    },
    {
      "from": "mcu.gpio-out1",
      "to": "dn-heartbeat.in",
      "latency": 0
    },
    {
      "from": "dn-pwm.out",
      "to": "driver.duty"
    },
    {
      "from": "dn-enable.out",
      "to": "driver.enable"
    },
    {
      "from": "dn-heartbeat.out",
      "to": "driver.heartbeat"
    },
    {
      "from": "driver.voltage",
      "to": "plant.voltage",
      "latency": 0
    }
  ],
  "ui": {
    "bundle": "ui-cartpole@0.1.0",
    "views": [
      "2d",
      "3d",
      "scope",
      "topology"
    ]
  }
