# compose.yaml が読む値の雛形。使うときは `.env` にコピーして書き換える (.env はコミットしない)。
# Windows では nerdctl / docker compose がシェルの環境変数を拾わないことがあるので、
# この .env に書くのが確実。

# 外から見える URL。ipemu:// リンクと、シェルが信頼する origin の照合に使う
IPEMU_PUBLIC_URL=http://127.0.0.1:8080

# 初回起動時だけ使う admin の初期パスワード。空にすると起動ログに生成値が出る。
# 実験用なら admin/admin でよい (初回ログイン後にパスワード変更を促されるが、
# 画面は見られる。API 経由の変更は 10 文字以上が要る)。
IPEMU_ADMIN_BOOTSTRAP_PASSWORD=admin

# json (既定) か text
IPEMU_LOG_FORMAT=json
RUST_LOG=info

# 土台イメージの取得元。docker.io の認証ヘルパが壊れている / 遮断環境では
# mirror.gcr.io/library にする
IPEMU_BASE_REGISTRY=docker.io/library
