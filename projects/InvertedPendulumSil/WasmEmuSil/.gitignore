# Rust
target/
# ビルド成果物 (scripts/build-*.sh が build/ に出す)
build/
# ネイティブ FW のビルド
firmware/fw-balance-c/build/
# Node
node_modules/
# wit-bindgen が生成するオブジェクト (build.sh が再生成する)
firmware/fw-balance-c/gen/*.o
# Electron シェルのビルド (esbuild / vite)
apps/shell/dist/
# 署名鍵 (ipemu-server keygen) とローカル実行時の保存領域
dev/keys/
dev/store/
store/
# クライアント配布 zip (scripts/package.sh)
/dist/
