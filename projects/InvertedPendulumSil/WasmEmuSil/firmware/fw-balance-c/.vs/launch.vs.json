{
  "version": "0.2.1",
  "configurations": [
    {
      "type": "default",
      "name": "ipemu run (native firmware, 仮想時間)",
      "project": "CMakeLists.txt",
      "projectTarget": "fw_balance",
      "exe": "${workspaceRoot}\\..\\..\\dist\\ipemu-client-0.1.0-windows-x64\\resources\\bin\\ipemu-engine.exe",
      "currentDir": "${workspaceRoot}\\..\\..",
      "args": [
        "run",
        "--manifest",
        "dev/cartpole.manifest.json",
        "--firmware",
        "balance=native:${cmake.buildRoot}\\Debug\\fw-balance-c.dll",
        "--no-signature-check",
        "--run-seconds",
        "60"
      ],
      "env": {
        "RUST_LOG": "info"
      }
    },
    {
      "type": "default",
      "name": "ipemu serve (native firmware, 実時間 + シェル)",
      "project": "CMakeLists.txt",
      "projectTarget": "fw_balance",
      "exe": "${workspaceRoot}\\..\\..\\dist\\ipemu-client-0.1.0-windows-x64\\resources\\bin\\ipemu-engine.exe",
      "currentDir": "${workspaceRoot}\\..\\..",
      "args": [
        "serve",
        "--manifest",
        "dev/cartpole.manifest.json",
        "--firmware",
        "balance=native:${cmake.buildRoot}\\Debug\\fw-balance-c.dll",
        "--no-signature-check",
        "--pacing",
        "realtime",
        "--auto-start",
        "--debug-friendly"
      ],
      "env": {
        "RUST_LOG": "info"
      }
    },
    {
      "type": "dll",
      "exe": "",
      "project": "CMakeLists.txt",
      "projectTarget": "fw-balance-c.dll (bin\\fw-balance-c.dll)",
      "name": "fw-balance-c.dll (bin\\fw-balance-c.dll)"
    }
  ]
}